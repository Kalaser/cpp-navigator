{
  "name": "cpp-navigator",
  "publisher": "local",
  "displayName": "C/C++ Navigator",
  "description": "Fast C/C++ code navigation using cscope/ctags or the built-in indexer",
  "version": "1.0.0",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kalaser/cpp-navigator.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cppNavigator.rebuildIndex",
        "title": "C/C++ Navigator: Rebuild Index (incremental)"
      },
      {
        "command": "cppNavigator.buildCscopeDb",
        "title": "C/C++ Navigator: Build cscope/ctags Database"
      },
      {
        "command": "cppNavigator.rebuildAll",
        "title": "C/C++ Navigator: Rebuild All (cscope + index)"
      },
      {
        "command": "cppNavigator.showStats",
        "title": "C/C++ Navigator: Show Index Stats"
      },
      {
        "command": "cppNavigator.clearHistory",
        "title": "C/C++ Navigator: Clear Browse History",
        "icon": "$(clear-all)"
      },
      {
        "command": "cppNavigator.searchSymbol",
        "title": "C/C++ Navigator: Search Symbol"
      },
      {
        "command": "cppNavigator.previewDefinition",
        "title": "C/C++ Navigator: Preview Definition"
      },
      {
        "command": "cppNavigator.searchSelectedText",
        "title": "C/C++ Navigator: Search Selected Text"
      },
      {
        "command": "cppNavigator.showCallHierarchy",
        "title": "C/C++ Navigator: Show Call Hierarchy"
      },
      {
        "command": "cppNavigator.showCallTreeGraph",
        "title": "C/C++ Navigator: Show Call Tree Graph"
      },
      {
        "command": "cppNavigator.markCaller",
        "title": "C/C++ Navigator: Mark as Caller"
      },
      {
        "command": "cppNavigator.linkToDefinition",
        "title": "C/C++ Navigator: Link to Definition"
      },
      {
        "command": "cppNavigator.clearCallTree",
        "title": "C/C++ Navigator: Clear Call Tree"
      },
      {
        "command": "cppNavigator.aiCleanCallTree",
        "title": "C/C++ Navigator: AI Clean Call Tree",
        "icon": "$(wand)"
      },
      {
        "command": "cppNavigator.configureDeepSeekApiKey",
        "title": "C/C++ Navigator: Configure DeepSeek API Key"
      },
      {
        "command": "cppNavigator.configureXiaomiApiKey",
        "title": "C/C++ Navigator: Configure Xiaomi MiMo API Key"
      },
      {
        "command": "cppNavigator.previewHistoryItem",
        "title": "C/C++ Navigator: Preview History Item"
      },
      {
        "command": "cppNavigator.openCallTreeNode",
        "title": "Open Call Tree Node"
      },
      {
        "command": "cppNavigator.aiAnalyzeFunction",
        "title": "AI: Analyze Function",
        "icon": "$(sparkle)"
      },
      {
        "command": "cppNavigator.aiExplainCallChain",
        "title": "AI: Explain Call Chain",
        "icon": "$(sparkle)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cppNavigator.callTreePanel",
          "title": "C/C++ Call Tree",
          "icon": "images/call-tree-icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "cppNavigator.historyView",
          "name": "C/C++ Browse History"
        }
      ],
      "cppNavigator.callTreePanel": [
        {
          "id": "cppNavigator.callTreeView",
          "name": "Call Tree"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "cppNavigator.clearHistory",
          "when": "view == cppNavigator.historyView",
          "group": "navigation"
        },
        {
          "command": "cppNavigator.clearCallTree",
          "when": "view == cppNavigator.callTreeView",
          "group": "navigation"
        },
        {
          "command": "cppNavigator.aiCleanCallTree",
          "when": "view == cppNavigator.callTreeView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "cppNavigator.previewHistoryItem",
          "when": "view == cppNavigator.historyView && viewItem == cppNavigatorHistoryItem",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "cppNavigator.previewDefinition",
          "when": "editorLangId == c || editorLangId == cpp",
          "group": "navigation@1"
        },
        {
          "command": "cppNavigator.searchSelectedText",
          "when": "editorLangId == c || editorLangId == cpp",
          "group": "navigation@2"
        },
        {
          "command": "cppNavigator.showCallHierarchy",
          "when": "editorLangId == c || editorLangId == cpp",
          "group": "navigation@3"
        },
        {
          "command": "cppNavigator.showCallTreeGraph",
          "when": "editorLangId == c || editorLangId == cpp",
          "group": "navigation@4"
        },
        {
          "command": "cppNavigator.markCaller",
          "when": "editorLangId == c || editorLangId == cpp",
          "group": "cppNav@1"
        },
        {
          "command": "cppNavigator.linkToDefinition",
          "when": "editorLangId == c || editorLangId == cpp",
          "group": "cppNav@2"
        },
        {
          "command": "cppNavigator.aiAnalyzeFunction",
          "when": "editorLangId == c || editorLangId == cpp",
          "group": "cppAi@1"
        },
        {
          "command": "cppNavigator.aiExplainCallChain",
          "when": "editorLangId == c || editorLangId == cpp",
          "group": "cppAi@2"
        }
      ]
    },
    "configuration": {
      "title": "C/C++ Navigator",
      "properties": {
        "cppNavigator.backend": {
          "type": "string",
          "enum": [
            "auto",
            "cscope",
            "builtin"
          ],
          "default": "auto",
          "description": "Backend: auto detects cscope databases, cscope forces cscope, builtin uses the internal indexer."
        },
        "cppNavigator.cscopeCmd": {
          "type": "string",
          "default": "cscope",
          "description": "Path to the cscope executable."
        },
        "cppNavigator.ctagsCmd": {
          "type": "string",
          "default": "ctags",
          "description": "Path to the ctags executable."
        },
        "cppNavigator.activeConfigs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Active preprocessor macros used by the builtin #ifdef filter."
        },
        "cppNavigator.extraRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra roots to index, such as vendor or SDK folders."
        },
        "cppNavigator.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/build/**",
            "**/out/**",
            "**/.git/**",
            "**/node_modules/**",
            "**/CMakeFiles/**"
          ],
          "description": "Glob patterns excluded from indexing."
        },
        "cppNavigator.ai.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable AI-assisted call-tree review. Candidate snippets and nearby source context are sent to the configured provider endpoint."
        },
        "cppNavigator.ai.provider": {
          "type": "string",
          "enum": [
            "deepseek",
            "xiaomi",
            "custom"
          ],
          "enumDescriptions": [
            "Use DeepSeek's OpenAI-compatible Chat Completions endpoint.",
            "Use Xiaomi MiMo's OpenAI-compatible Chat Completions endpoint.",
            "Use a custom OpenAI-compatible Chat Completions endpoint."
          ],
          "default": "deepseek",
          "description": "AI provider used for call-tree review. Xiaomi selects MiMo defaults unless endpoint/model are explicitly configured."
        },
        "cppNavigator.ai.endpoint": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "AI API base URL used for call-tree review. Xiaomi default is https://api.xiaomimimo.com/v1 when this setting is not explicitly configured. A full /chat/completions URL is also accepted."
        },
        "cppNavigator.ai.apiKey": {
          "type": "string",
          "default": "",
          "description": "Optional DeepSeek/custom API key used for AI call-tree review. Prefer the Configure DeepSeek API Key command, which stores the key in VS Code SecretStorage. If no stored secret exists, this setting, DEEPSEEK_API_KEY, or CPP_NAVIGATOR_AI_API_KEY is used."
        },
        "cppNavigator.ai.xiaomiApiKey": {
          "type": "string",
          "default": "",
          "description": "Optional Xiaomi MiMo API key used when cppNavigator.ai.provider is xiaomi. Prefer the Configure Xiaomi MiMo API Key command, which stores the key in VS Code SecretStorage. If no stored secret exists, this setting, MIMO_API_KEY, or XIAOMI_API_KEY is used."
        },
        "cppNavigator.ai.model": {
          "type": "string",
          "default": "deepseek-v4-pro",
          "description": "Model name used for AI call-tree review. Xiaomi default is mimo-v2.5-pro when this setting is not explicitly configured."
        },
        "cppNavigator.ai.timeoutMs": {
          "type": "number",
          "default": 45000,
          "description": "Timeout in milliseconds for one AI review batch."
        },
        "cppNavigator.ai.contextLines": {
          "type": "number",
          "default": 8,
          "description": "Number of source lines captured before and after each candidate call site."
        },
        "cppNavigator.ai.batchSize": {
          "type": "number",
          "default": 30,
          "description": "Maximum candidate nodes sent in one AI review request."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^9.4.3"
  }
}
